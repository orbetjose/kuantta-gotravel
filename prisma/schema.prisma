generator client {
  provider = "prisma-client"
  output   = "../libs/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String     @id @default(cuid())
  name                String?
  email               String     @unique
  password            String?
  emailVerified       DateTime?
  image               String?
  role                Role       @default(ADMINISTRADOR)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  accounts            Account[]
  notas               Nota[]
  serviciosCreados    Servicio[] @relation("ServiciosCreados")
  serviciosFacturados Servicio[] @relation("ServiciosFacturados")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Nota {
  id        String  @id @default(cuid())
  titulo    String  @db.VarChar(100)
  contenido String  @db.Text
  fijada    Boolean @default(false)
  usuarioId String
  usuario   User    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId, createdAt])
}

model Cliente {
  id Int @id @default(autoincrement())

  nombre      String
  razonSocial String?

  tipoDocumento TipoDocumento
  documento     String        @unique

  direccion String?
  ciudad    String?
  telefono  String
  correo    String

  tipoPersona TipoPersona

  observaciones String?

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servicios Servicio[]
}

enum TipoPersona {
  NATURAL
  JURIDICA
}

enum TipoDocumento {
  NIT
  CEDULA
  PASAPORTE
}

model Pasajero {
  id Int @id @default(autoincrement())

  nombre           String
  apellido         String
  documento        String           @unique
  fechaNacimiento  DateTime
  correo           String
  telefono         String
  preferenciaSilla PreferenciaSilla

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servicios Servicio[]
}

enum PreferenciaSilla {
  VENTANA
  PASILLO
}

model Servicio {
  id          Int            @id @default(autoincrement())
  clienteId   Int
  proveedorId Int?
  pasajeroId  Int
  tipo        TipoServicio
  estado      EstadoServicio @default(BORRADOR)

  // Datos generales
  fechaEmision   DateTime
  fechaSolicitud DateTime

  // Documentos
  facturaProveedorUrl          String?
  facturaGoTravelUrl           String?
  soporteTiqueteElectronicoUrl String?
  observaciones                String?

  // Forma de pago
  formaPago          TipoPago
  tipoCash           TipoCash?
  numeroTarjeta      String?
  numeroAprobacion   String?
  creditoAgencia     Int?
  comprobantePagoUrl String?

  // Información administrativa
  proyectoFCDS String?
  ceCos        String?

  vencimientoFacturaProveedor DateTime?
  pagadoProveedor             TipoPagadoProveedor?
  fechaPagoProveedor          DateTime?
  fechaPagoCliente            DateTime?
  pagadoCliente               Boolean              @default(false)

  // Facturación
  creadoPorId      String
  facturadoPorId   String?
  fechaFacturacion DateTime?
  motivoDevolucion String?

  uuid      String   @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  proveedor Proveedor? @relation(fields: [proveedorId], references: [id])
  pasajero  Pasajero   @relation(fields: [pasajeroId], references: [id])

  creadoPor    User  @relation("ServiciosCreados", fields: [creadoPorId], references: [id])
  facturadoPor User? @relation("ServiciosFacturados", fields: [facturadoPorId], references: [id])

  tiquete         Tiquete?
  detalleServicio DetalleServicio?
}

model DetalleServicio {
  id         Int @id @default(autoincrement())
  servicioId Int @unique

  descripcionServicio String
  codigoReserva       String
  ciudad              String
  pais                String

  fechaIngreso DateTime?
  fechaSalida  DateTime?

  tarifaNeta            Decimal
  ivaTarifa             Decimal
  feePagoTarjetaCredito Decimal
  totalVentaAgencia     Decimal

  tarifaNetaProveedor Decimal
  ivaTarifaProveedor  Decimal
  comisionAgencia     Decimal
  totalPagado         Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  servicio  Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
}

enum TipoViaje {
  NACIONAL
  INTERNACIONAL
}

enum TipoItinerario {
  SOLO_IDA
  IDA_VUELTA
  MULTIDESTINO
}

enum CanalVenta {
  AMADEUS
  SABRE
  KONTROL_TRAVEL
  KIU_TRAVEL
  NDC
  OTROS
}

model Tiquete {
  id         Int @id @default(autoincrement())
  servicioId Int @unique

  numeroTiquete String
  codigoReserva String
  canalVenta    CanalVenta

  tipoViaje      TipoViaje
  tipoItinerario TipoItinerario
  trayectos      TrayectoTiquete[]

  revision              Boolean
  numeroTiqueteRevision String?

  clase String

  tarifaNeta               Decimal
  ivaTarifa                Decimal
  otrosImpuestos           Decimal
  tarifaAdministrativaNeta Decimal
  ivaTarifaAdministrativa  Decimal
  feeAgenciaNeta           Decimal
  ivaFeeAgencia            Decimal
  tarifaAPH                Decimal
  ivaTarifaAPH             Decimal?

  totalPagar Decimal

  fechaEmisionTiqueteFES DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servicio Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
}

model TrayectoTiquete {
  id           Int       @id @default(autoincrement())
  tiqueteId    Int
  orden        Int
  origenId     Int
  destinoId    Int
  fechaSalida  DateTime
  fechaRegreso DateTime?

  tiquete Tiquete @relation(fields: [tiqueteId], references: [id], onDelete: Cascade)

  origen Ruta @relation("AeropuertoOrigen", fields: [origenId], references: [id])

  destino Ruta @relation("AeropuertoDestino", fields: [destinoId], references: [id])

  @@unique([tiqueteId, orden])
  @@index([origenId])
  @@index([destinoId])
}

model Proveedor {
  id Int @id @default(autoincrement())

  razonSocial     String
  nombreComercial String?
  nit             String  @unique

  categoria         CategoriaProveedor
  ciudad            String?
  direccion         String?
  telefono          String?
  correoComercial   String?
  correoFacturacion String?
  contacto          String?

  remuneracion  RemuneracionProveedor
  monedaBase    Moneda
  condicionPago CondicionPago

  documentosPdf String[]

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servicios Servicio[]
}

enum CategoriaProveedor {
  HOTEL_CADENA
  ASISTENCIA_MEDICA
  TECNOLOGIA_GDS
  CONSOLIDADOR
  MAYORISTA
  AEROLINEA
  HOTEL_PLATAFORMA
  TRANSPORTE_TERRESTRE
}

enum RemuneracionProveedor {
  COMISION
  NETO_MARKUP
}

enum Moneda {
  COP
  USD
  EUR
}

enum CondicionPago {
  INMEDIATO
  CREDITO
}

model Ruta {
  id               Int      @id @default(autoincrement())
  codigoIATA       String   @unique
  nombreAeropuerto String
  ciudad           String
  pais             String
  region           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  activo           Boolean  @default(true)

  origenes TrayectoTiquete[] @relation("AeropuertoOrigen")
  destinos TrayectoTiquete[] @relation("AeropuertoDestino")
}

enum Role {
  ADMINISTRADOR
  ASESOR
  FACTURADOR
}

enum TYPE_DOCUMENT {
  CC
  PAS
  RUC
}

enum TipoServicio {
  TIQUETE
  HOTEL
  ALQUILER_AUTO
  SALON
  EVENTO
  SILLA
  TARJETA_ASISTENCIA
  TRASLADO
  VISA
  WEB_CHECKIN
  PLAN_VACACIONAL
}

enum TipoPagadoProveedor {
  SI
  NO
  NO_APLICA
}

enum EstadoServicio {
  BORRADOR
  DEVUELTO
  POR_FACTURAR
  FACTURADO
  ANULADO
}

enum TipoPago {
  CASH
  TARJETA_CREDITO
  CREDITO_AGENCIA
  OTROS
}

enum TipoCash {
  EFECTIVO
  TRANSFERENCIA
}
